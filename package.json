{
  "name": "vending-machine-3d",
  "version": "0.1.0",
  "description": "3D vending machine simulator & editor (three.js), XML-driven, for vanilla JS and Vue 3",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "vite --config vite.demo.config.ts",
    "build": "BUILD_TARGET=es vite build && BUILD_TARGET=umd vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7",
    "vue": "3.5"
  }
}
