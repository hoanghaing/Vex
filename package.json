{
  "name": "vending-machine-3d",
  "version": "0.1.0",
  "description": "3D vending machine simulator & editor (three.js), XML-driven, for vanilla JS and Vue 3",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build --mode es && vite build --mode umd && tsc -p tsconfig.build.json",
    "size": "node scripts/size.mjs",
    "build:demo": "npm run build && node scripts/copy-umd.mjs && vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue": "3.5"
  },
  "main": "./dist/vending-machine-3d.umd.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vending-machine-3d.umd.js",
  "jsdelivr": "./dist/vending-machine-3d.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/vending-machine-3d.umd.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./umd": "./dist/vending-machine-3d.umd.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "three",
    "threejs",
    "vending-machine",
    "3d",
    "editor",
    "xml",
    "vue",
    "vue3"
  ]
}
